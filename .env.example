# ==========================================
# AI Study Companion - Environment Variables
# ==========================================

# Database: MongoDB Atlas (Recommended for production)
# NOTE: Ensure IP Access List on MongoDB Atlas allows 0.0.0.0/0 (anywhere) for cloud hosts.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/ai_study_companion?retryWrites=true&w=majority"
# Local fallback:
# MONGODB_URI="mongodb://localhost:27017/ai_study_companion"

# Authentication: Secure random secret (e.g., openssl rand -base64 32)
JWT_SECRET="generate_a_secure_jwt_secret_for_production"

# AI Provider ("gemini" | "openai" | "mock")
AI_PROVIDER="gemini"
GEMINI_API_KEY="your_gemini_api_key_here"
# Optional if using OpenAI
OPENAI_API_KEY="your_openai_api_key_here"

# Environment & Server Config
NODE_ENV="production"
PORT=5000

# Client Origins for CORS (comma-separated if multiple domains)
# For monolithic deployment (Express serving frontend), leave empty or set to your domain.
# For decoupled frontend (Vercel/Netlify), set to your frontend domain:
CLIENT_URL="https://your-frontend-domain.vercel.app,http://localhost:5173"

# Uploads directory (use /tmp/uploads on serverless or ephemeral containers if needed)
UPLOADS_DIR="./uploads"